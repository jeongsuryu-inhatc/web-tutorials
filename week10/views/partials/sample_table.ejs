<table border="1">
  <thead><tr><th>ID</th><th>과목명</th><th>점수</th></tr></thead>
  <tbody>
    <% subjects.forEach((item) => { %>
      <tr><td><%= item.id %></td><td><%= item.subject %></td><td><%= item.score %></td></tr>
    <% }); %>
    <% if (subjects.length === 0) { %>
      <tr><td colspan="3">조회 결과가 없습니다.</td></tr>
    <% } %>
  </tbody>
</table>
